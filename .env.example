# Copy to .env and replace placeholders. Do not commit .env.
# Real API secrets belong in environment variables or `dotnet user-secrets`.

# PostgreSQL (docker-compose + connection string parts)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ayurveda_hospital
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

# JWT signing key placeholder (override Jwt__SigningKey via env / user-secrets)
JWT_SECRET=change-me-use-at-least-32-characters!!

# Local Ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Agent service (127.0.0.1 only). AGENT_ prefix matches pydantic-settings.
AGENT_PORT=8001
AGENT_HOSPITAL_API_BASE_URL=http://127.0.0.1:5080
AGENT_BACKEND_BASE_URL=http://127.0.0.1:5080
AGENT_SHARED_SECRET=dev-internal-agent-secret

# One secret for both processes. Header: X-Internal-Service-Key.
# The API and the agent both read INTERNAL_SERVICE_KEY.
# Replace the placeholder locally. Do not commit a real key.
INTERNAL_SERVICE_KEY=replace-with-a-random-key
