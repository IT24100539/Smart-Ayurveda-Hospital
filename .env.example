# Copy to .env and replace every placeholder. Do not commit .env.
# The API reads the same values from environment variables or `dotnet user-secrets`,
# not from this file. docker compose reads POSTGRES_PASSWORD. The agent reads the AGENT_ names.

# PostgreSQL (docker compose)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ayurveda_hospital
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-me

# API connection string (user-secrets key ConnectionStrings:DefaultConnection, or this env name)
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=ayurveda_hospital;Username=postgres;Password=replace-me

# JWT (user-secrets key Jwt:SigningKey). At least 32 characters.
Jwt__SigningKey=replace-me-with-at-least-32-random-characters
Jwt__Issuer=smart-ayurveda-hospital
Jwt__Audience=smart-ayurveda-staff

# Local Ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Agent service (127.0.0.1 only). AGENT_ prefix matches pydantic-settings.
AGENT_PORT=8001
AGENT_HOSPITAL_API_BASE_URL=http://127.0.0.1:5080
AGENT_BACKEND_BASE_URL=http://127.0.0.1:5080
AGENT_SHARED_SECRET=replace-me
AGENT_OLLAMA_BASE_URL=http://127.0.0.1:11434

# One secret for both processes. Header: X-Internal-Service-Key.
INTERNAL_SERVICE_KEY=replace-me

# Production browser origins only (staff web, then Flutter web). https, no localhost, no trailing slash.
AllowedOrigins=https://YOUR_STAFF_WEB_ORIGIN,https://YOUR_FLUTTER_WEB_ORIGIN

# Production certificate when the process itself terminates TLS (omit both on Render, which sets PORT).
Kestrel__Certificates__Default__Path=certificates/YOUR_CERT.pfx
Kestrel__Certificates__Default__Password=replace-me
