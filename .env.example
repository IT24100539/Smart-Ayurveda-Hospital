# Copy to .env and replace placeholders. Do not commit .env.
# Real API secrets belong in environment variables or `dotnet user-secrets`.

# PostgreSQL (docker-compose + connection string parts)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ayurveda_hospital
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

# JWT signing key placeholder (override Jwt__SigningKey via env / user-secrets)
JWT_SECRET=change-me-use-at-least-32-characters!!

# Local Ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
