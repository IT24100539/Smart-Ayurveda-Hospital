{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=ayurveda_hospital;Username=postgres;Password=YOUR_SECURE_DB_PASSWORD"
  },
  "Jwt": {
    "Issuer": "smart-ayurveda-hospital",
    "Audience": "smart-ayurveda-staff",
    "SigningKey": "YOUR_SECURE_JWT_SIGNING_KEY_32_PLUS_CHARS",
    "ExpiryMinutes": 120
  },
  "AgentService": {
    "BaseUrl": "http://127.0.0.1:8100",
    "SharedSecret": "YOUR_SECURE_AGENT_SHARED_SECRET"
  },
  "InternalService": {
    "ApiKey": "YOUR_INTERNAL_SERVICE_KEY"
  },
  "ComplaintEscalation": {
    "IntervalHours": 1
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ],
    "StaffOrigins": [ "http://localhost:5173" ]
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
