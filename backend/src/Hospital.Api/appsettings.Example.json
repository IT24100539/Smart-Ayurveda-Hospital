{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=ayurveda_hospital;Username=postgres;Password=YOUR_DB_PASSWORD"
  },
  "Jwt": {
    "Issuer": "smart-ayurveda-hospital",
    "Audience": "smart-ayurveda-staff",
    "SigningKey": "YOUR_JWT_SIGNING_KEY_AT_LEAST_32_CHARS",
    "ExpiryMinutes": 120
  },
  "AgentService": {
    "BaseUrl": "http://127.0.0.1:8001",
    "SharedSecret": "YOUR_AGENT_SHARED_SECRET"
  },
  "InternalService": {
    "ApiKey": "YOUR_INTERNAL_SERVICE_KEY"
  },
  "ComplaintEscalation": {
    "IntervalHours": 1
  },
  "Auth": {
    "Lockout": {
      "MaxFailedAttempts": 5,
      "LockoutMinutes": 15
    },
    "RateLimit": {
      "PermitLimit": 20,
      "WindowSeconds": 60
    }
  },
  "PasswordPolicy": {
    "MinimumLength": 8,
    "MaximumLength": 128,
    "RequireUppercase": true,
    "RequireLowercase": true,
    "RequireDigit": true,
    "RequireNonAlphanumeric": true
  },
  "Cors": {
    "StaffOrigins": [ "https://YOUR_STAFF_WEB_ORIGIN" ],
    "FlutterWebOrigins": [ "https://YOUR_FLUTTER_WEB_ORIGIN" ]
  },
  "Kestrel": {
    "Certificates": {
      "Default": {
        "Path": "certificates/YOUR_CERT.pfx",
        "Password": "YOUR_CERTIFICATE_PASSWORD"
      }
    }
  },
  "DoctorPhotos": {
    "StoragePath": "",
    "MaxBytes": 524288
  },
  "MedicalDocuments": {
    "StoragePath": "",
    "MaxBytes": 10485760
  },
  "AllowedHosts": "*"
}
