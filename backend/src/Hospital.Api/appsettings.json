{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=ayurveda_hospital;Username=postgres"
  },
  "Jwt": {
    "Issuer": "smart-ayurveda-hospital",
    "Audience": "smart-ayurveda-staff",
    "SigningKey": "",
    "ExpiryMinutes": 120
  },
  "AgentService": {
    "BaseUrl": "http://127.0.0.1:8100",
    "SharedSecret": ""
  },
  "InternalService": {
    "ApiKey": ""
  },
  "ComplaintEscalation": {
    "IntervalHours": 1
  },
  "Auth": {
    "Lockout": {
      "MaxFailedAttempts": 5,
      "LockoutMinutes": 15
    },
    "RateLimit": {
      "PermitLimit": 20,
      "WindowSeconds": 60
    }
  },
  "PasswordPolicy": {
    "MinimumLength": 8,
    "MaximumLength": 128,
    "RequireUppercase": true,
    "RequireLowercase": true,
    "RequireDigit": true,
    "RequireNonAlphanumeric": true
  },
  "Cors": {
    "StaffOrigins": [],
    "FlutterWebOrigins": []
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "DoctorPhotos": {
    "StoragePath": "",
    "MaxBytes": 524288
  },
  "MedicalDocuments": {
    "StoragePath": "",
    "MaxBytes": 10485760
  },
  "AllowedHosts": "*"
}
