<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug builds only. Android 9+ blocks cleartext HTTP by default, which would
  stop the app reaching Hospital.Api over http://10.0.2.2:5080 during local
  development. Cleartext stays disabled everywhere else, and release builds do
  not include this file at all.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <!-- The Android emulator's alias for the host machine's loopback. -->
        <domain includeSubdomains="false">10.0.2.2</domain>
        <!-- Genymotion's equivalent alias. -->
        <domain includeSubdomains="false">10.0.3.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
